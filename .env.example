# Kai's Shopify shop – products, prices and photos are pulled from here
SHOP_URL=https://toytake2.co.uk

# Your details (shown on the site)
WHATSAPP_NUMBER=447000000000          # international format, no + or spaces
CONTACT_EMAIL=hello@sethome.uk
COMMUNITY_INVITE_URL=https://chat.whatsapp.com/your-invite-code
SITE_URL=https://sethome.uk

# Pricing
MARKUP_PERCENT=0            # added on top of Kai's price (0 = same price as Kai's shop)
PACK_DISCOUNT_PERCENT=5     # discount on packs vs buying items separately
DELIVERY_FEE=0              # £ added to every pack ("delivered and set up")
DEPOSIT=50                  # £ deposit to reserve

# Optional: card payments for the deposit (from your Stripe dashboard)
STRIPE_SECRET_KEY=

# Optional: where wanted-list and reservation details are sent (e.g. a Google Sheet script URL)
LEADS_WEBHOOK_URL=
